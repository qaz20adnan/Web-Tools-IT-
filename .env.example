# ---------------------------------------------------------------------------
# NEXORA AI — server-side environment (Netlify Functions)
# Copy to .env for `netlify dev`. NEVER commit real values.
# ---------------------------------------------------------------------------

# Default AI provider. One of: openai | anthropic | gemini | openrouter | ollama | custom
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=
AI_API_KEY=
# Optional: retried automatically when the primary model is missing/unsupported.
AI_FALLBACK_MODEL=

# Optional attribution headers sent with OpenRouter requests (no secrets).
AI_APP_REFERER=https://nexora-ai.netlify.app
AI_APP_TITLE=NEXORA AI

# Optional secondary provider used for vision requests (must be OpenAI-compatible)
AI_VISION_PROVIDER=
AI_VISION_BASE_URL=
AI_VISION_MODEL=
AI_VISION_API_KEY=

# Security: comma-separated allowlist of hosts the AI proxy may contact.
# Leave empty to allow only the built-in provider hosts.
AI_ALLOWED_HOSTS=
# Allow http://localhost / 127.0.0.1 for a local Ollama server.
ALLOW_LOCAL_AI=false

# Network printer diagnostics. Private LAN probes are allowed automatically when
# the app runs locally. Enable explicitly only for a trusted self-hosted setup.
PRINTER_ALLOW_PRIVATE=false
# Public printer probing is disabled by default to avoid acting as a public scanner.
PRINTER_ALLOW_PUBLIC=false

# Request limits
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=2500
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Research providers (optional). Without a key, research falls back to
# curated official-site search links that the user can open manually.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Comma separated RSS feeds for Tech Pulse (optional; defaults are built in)
NEWS_FEEDS=

# Supabase. Required for accounts, RBAC, trials, subscriptions and the private
# workspace. The service role key is ONLY read inside serverless functions and
# must never be exposed to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NEXORA account platform
APP_NAME=NEXORA AI
# Verified email of the one-time owner bootstrap account. Leave empty until the
# project and migration are ready. Never use a public/shared address.
NEXORA_OWNER_EMAIL=
# Default trial length in days (1-365); admins can override it in the database.
NEXORA_TRIAL_DAYS=30
# Public site origin used in verification/recovery redirects (no trailing slash).
NEXORA_SITE_URL=http://localhost:5173
# Required for trial claim hashing. Generate with: openssl rand -hex 32
NEXORA_HASH_PEPPER=
NEXORA_MAINTENANCE_MODE=false

# Token required by the content admin endpoint (POST /api/content/admin).
# Generate with: openssl rand -hex 32
CONTENT_ADMIN_TOKEN=

# Structured logs are emitted to the Netlify log stream. Secrets are redacted.
LOG_LEVEL=info
